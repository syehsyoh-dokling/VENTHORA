# VENTHORA configuration. Copy to .env (git-ignored) and fill in. Never commit .env.

# --- Airwallex sandbox (names as in the organizers' guide, https://airwallexdev.com/guide) ---
# Sandbox web app -> Account -> Developer -> API keys (https://sandbox.airwallex.com)
AWX_CLIENT_ID=
AWX_API_KEY=
AWX_BASE_URL=https://api.sandbox.airwallex.com
# Global Account that receives simulated deposits: GET /api/v1/global_accounts (or GET /api/airwallex/global-accounts)
AWX_GLOBAL_ACCOUNT_ID=

# --- Evidence reader LLM (OpenAI-compatible) ---
# Local: python scripts/local_llm_server.py --port 8001. Leave empty for the deterministic lexicon reader.
MODEL_ENDPOINT=http://127.0.0.1:8001
MODEL_NAME=Qwen/Qwen2.5-0.5B-Instruct
MODEL_TOKEN=

# --- Optional authorities ---
OPA_URL=
TB_ADDRESS=
TB_CLUSTER_ID=0
TB_ACCOUNT_ID=
VENTHORA_NATIVE_LIB=

# --- Optional external engines (docs/ENGINE_CONTRACTS.md) ---
VENTHORA_VERITY_URL=
VENTHORA_HORIZON_URL=
VENTHORA_THEOREM_URL=

# --- Storage ---
VENTHORA_AUDIT_DB=./data/venthora_audit.db
VENTHORA_EXECUTION_DB=./data/venthora_execution.db
VENTHORA_ECB_CSV=./data/imports/eurofxref-hist.csv
